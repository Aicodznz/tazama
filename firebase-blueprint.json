{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in Tazama platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["viewer", "creator", "moderator", "admin"] },
        "country": { "type": "string", "maxLength": 50 },
        "preferredLanguage": { "type": "string", "enum": ["sw", "en"] },
        "channelId": { "type": "string", "maxLength": 128 },
        "balanceTZS": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName", "role"]
    },
    "Channel": {
      "title": "Channel",
      "description": "Creator channel profile and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "handle": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 1000 },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "bannerUrl": { "type": "string", "maxLength": 1000 },
        "subscriberCount": { "type": "number" },
        "videoCount": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "isMonetized": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "handle", "name"]
    },
    "Video": {
      "title": "Video",
      "description": "Video metadata, streaming asset reference, and metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 128 },
        "channelName": { "type": "string", "maxLength": 100 },
        "channelAvatar": { "type": "string", "maxLength": 1000 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 5000 },
        "videoUrl": { "type": "string", "maxLength": 1000 },
        "streamPlaybackId": { "type": "string", "maxLength": 200 },
        "thumbnailUrl": { "type": "string", "maxLength": 1000 },
        "durationSeconds": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "tags": { "type": "string", "maxLength": 500 },
        "visibility": { "type": "string", "enum": ["public", "unlisted", "private"] },
        "isShort": { "type": "boolean" },
        "viewsCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "processingStatus": { "type": "string", "enum": ["ready", "processing", "error"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "channelId", "title", "visibility"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment on a video",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "videoId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 1000 },
        "text": { "type": "string", "maxLength": 2000 },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "videoId", "userId", "userName", "text"]
    },
    "Like": {
      "title": "Like",
      "description": "Video reaction like/dislike",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "videoId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "isLike": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "videoId", "userId", "isLike"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Channel follower relation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "subscriberId": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 128 },
        "channelName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "subscriberId", "channelId"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "User curated playlist of videos",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "videoIds": { "type": "string", "maxLength": 2000 },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "Gift": {
      "title": "Gift",
      "description": "Virtual gift sent to a creator",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "channelId": { "type": "string", "maxLength": 128 },
        "videoId": { "type": "string", "maxLength": 128 },
        "giftType": { "type": "string", "maxLength": 50 },
        "amountTZS": { "type": "number" },
        "message": { "type": "string", "maxLength": 250 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "senderId", "channelId", "amountTZS"]
    },
    "CreatorMembership": {
      "title": "CreatorMembership",
      "description": "Paid creator membership subscription",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 128 },
        "tierName": { "type": "string", "maxLength": 50 },
        "monthlyFeeTZS": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "cancelled", "expired"] },
        "validUntil": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "channelId", "tierName", "monthlyFeeTZS", "status"]
    },
    "Report": {
      "title": "Report",
      "description": "Content moderation report filed by user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["video", "comment", "channel"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed", "action_taken"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "reason", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/channels/{channelId}": {
      "schema": "Channel",
      "description": "Creator channels"
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Published and processing video items"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Video comments"
    },
    "/likes/{likeId}": {
      "schema": "Like",
      "description": "Video reaction likes and dislikes"
    },
    "/subscriptions/{subId}": {
      "schema": "Subscription",
      "description": "Channel subscriptions"
    },
    "/playlists/{playlistId}": {
      "schema": "Playlist",
      "description": "Curated user playlists"
    },
    "/gifts/{giftId}": {
      "schema": "Gift",
      "description": "Virtual creator gifts"
    },
    "/creatorMemberships/{membershipId}": {
      "schema": "CreatorMembership",
      "description": "Creator membership tiers and subscriptions"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Content moderation reports"
    }
  }
}
