# FIREBASE CLIENT CONFIGURATION
VITE_FIREBASE_API_KEY="AIzaSy_YOUR_FIREBASE_API_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# CLOUDFLARE STREAM VIDEO INFRASTRUCTURE
# Cloudflare Account ID and Stream API Token for Direct Uploads & Signed Playback URLs
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_STREAM_API_TOKEN="YOUR_CLOUDFLARE_STREAM_API_TOKEN"
CLOUDFLARE_STREAM_WEBHOOK_SECRET="YOUR_CLOUDFLARE_WEBHOOK_SECRET"

# TANZANIA MOBILE MONEY GATEWAY (Tigo Pesa, M-Pesa, Airtel Money, Halopesa)
# Integration provider credentials (e.g. Selcom, DPO Pay, Flutterwave, AzamPay)
MOBILE_MONEY_GATEWAY_API_KEY="YOUR_PAYMENT_GATEWAY_API_KEY"
MOBILE_MONEY_GATEWAY_SECRET="YOUR_PAYMENT_GATEWAY_SECRET"
MOBILE_MONEY_WEBHOOK_SECRET="YOUR_PAYMENT_WEBHOOK_SIGNING_SECRET"

# GEMINI AI API (Auto-injected by Google AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP RUNTIME URL
APP_URL="MY_APP_URL"
